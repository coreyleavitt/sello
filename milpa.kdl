// generated by milpa; edit by hand or via `milpa add` / `milpa remove`

name "sello"

version "0.5.0"

src_dir "src"

deps {
    // RFC-005 slice 2: pinned by commit SHA, not ref="main" -- an
    // unpinned branch ref left the code that executes in required CI
    // jobs (the property suites) with no integrity check (milpa 0.0.1's
    // `verify` has no --features flag, so it never covers this optional
    // dep). Pinned at the canonical repo URL, not the redirecting
    // "proptest" URL (the repo was renamed proptest -> nelli 2026-08-13;
    // the redirect works today, but a future rename-reuse of the old name
    // could otherwise silently retarget this dependency).
    //
    // Commit ec7a405c354e79c30717b0692ad548bc8bee7414 (2026-08-13,
    // "docs(handoff): record 0.3.4 release and stage-3 resume state") is
    // deliberately NOT current main HEAD: it is the last commit before
    // 785307c "refactor: rename package proptest -> nelli", which renamed
    // the Nim source tree itself (src/proptest.nim -> src/nelli.nim,
    // srcDir package identity, umbrella module name) -- not just the
    // GitHub repo. Every sello test file does `import proptest`
    // (tests/unit/test_properties_*.nim) and CLAUDE.md's "proptest"
    // vocabulary runs throughout the whole project; following main past
    // 785307c would break every one of those imports and require a
    // project-wide `import proptest` -> `import nelli` sweep, which is
    // its own deliberate migration, not a CI-integrity slice's job.
    // ec7a405 is the newest commit that keeps `import proptest` working.
    "proptest" git=(url)"https://github.com/coreyleavitt/nelli.git" ref="ec7a405c354e79c30717b0692ad548bc8bee7414" optional=#true
}

// RFC-005 slice 2: proptest's own manifest pins nim-z3 at ref="main" too
// (see _deps/proptest's milpa.kdl, or github.com/coreyleavitt/nelli's
// manifest at the pinned commit above) -- the same mutable-branch hole
// one level down the transitive graph, closed here with an override
// pinned at nim-z3's main HEAD as of this slice (verified compatible:
// z3/softlink are resolved and fetched but never compiled by the
// property suite -- only proptest/symex imports z3, and the top-level
// proptest module this project imports never does, per CLAUDE.md).
// softlink is left unoverridden: nim-z3's own manifest already pins it
// by version tag (ref="v0.11.1"), not a mutable branch -- the specific
// hole this RFC targets.
overrides {
    pkg "z3" git=(url)"https://github.com/coreyleavitt/nim-z3.git" ref="7d9abdaefecce2e4175354a73b047e2548dd2a19"
}

kind "library"
