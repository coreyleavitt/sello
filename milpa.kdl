// generated by milpa; edit by hand or via `milpa add` / `milpa remove`

name "sello"

version "0.5.0"

src_dir "src"

deps {
    // nelli migration (superseding RFC-005 slice 2's re-pin below):
    // pinned by commit SHA, not ref="main" -- same standing posture as
    // before, at the canonical repo URL (github.com/coreyleavitt/nelli --
    // this project never depended on the old redirecting "proptest" URL).
    //
    // Commit 67f890dee81480bc71fb47e985de05817e631147 (nelli main HEAD as
    // of this migration, "ci: skip the Windows legs on prose-only
    // pushes") absorbs the three breaking
    // changes 0.6.0/0.7.0 introduced over the previously-pinned
    // ec7a405c354e79c30717b0692ad548bc8bee7414: the FuzzSettings
    // ExecutorConfig/GuidanceConfig/SchedulingConfig regroup (ADR-0031),
    // `import nelli` no longer re-exporting `nelli/symex`, and the
    // `writeCrashArtifacts` -> CrashRecorder/crashinfo replacement -- see
    // CLAUDE.md's "Building & testing" section and the handoff doc for
    // the full absorption record. The dep alias is renamed `proptest` ->
    // `nelli` in the same commit (the package's own identity as of the
    // 785307c rename this project's prior pin deliberately stayed behind)
    // -- `--features nelli` is now the fetch flag, `_deps/nelli` the
    // populated directory, `import nelli` the top-level import.
    //
    // Prior pin history (RFC-005 slice 2): ec7a405c354e79c30717b0692ad548bc8bee7414,
    // the last commit before 785307c "refactor: rename package proptest ->
    // nelli" (which renamed the Nim source tree itself, not just the
    // GitHub repo) -- deliberately held back until this dedicated
    // migration, per that slice's own re-pin paragraph.
    "nelli" git=(url)"https://github.com/coreyleavitt/nelli.git" ref="67f890dee81480bc71fb47e985de05817e631147" optional=#true
}

// nelli's own manifest still pins nim-z3 at ref="main" (see
// _deps/nelli/milpa.kdl, or github.com/coreyleavitt/nelli's manifest at
// the pinned commit above) -- the same mutable-branch hole one level down
// the transitive graph, closed here with an override pinned at nim-z3's
// main HEAD as of RFC-005 slice 2 (verified compatible: z3/softlink are
// resolved and fetched but never compiled by the property suite -- only
// nelli/symex imports z3, and the top-level nelli module this project
// imports never does, per CLAUDE.md). softlink is left unoverridden:
// nim-z3's own manifest already pins it by version tag (ref="v0.11.1"),
// not a mutable branch -- the specific hole this RFC targets.
overrides {
    pkg "z3" git=(url)"https://github.com/coreyleavitt/nim-z3.git" ref="7d9abdaefecce2e4175354a73b047e2548dd2a19"
}

kind "library"
